local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local localPlayer = Players.LocalPlayer
local massInfectionEvent = ReplicatedStorage:WaitForChild("MasssInfection")

local ZOOM_MIN_TARGET = 3
local ZOOM_MAX_TARGET = 15

local zoomInInfo = TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local zoomOutInfo = TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local isCasting = false

local animObject = Instance.new("Animation")
animObject.AnimationId = "rbxassetid://97163586161932"

local function GetCharacterAndHumanoid()
	local character = localPlayer.Character
	if not character then return nil, nil end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil, nil end
	
	return character, humanoid
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or isCasting then return end
	if input.KeyCode ~= Enum.KeyCode.R then return end

	local character, humanoid = GetCharacterAndHumanoid()
	if not character or not humanoid then return end

	local animator = humanoid:WaitForChild("Animator", 2)
	if not animator then return end

	isCasting = true
	massInfectionEvent:FireServer()

	local track = animator:LoadAnimation(animObject)
	track:Play()
	track:AdjustSpeed(0.2)

	local zoomInTween = TweenService:Create(localPlayer, zoomInInfo, {
		CameraMinZoomDistance = ZOOM_MIN_TARGET,
		CameraMaxZoomDistance = ZOOM_MIN_TARGET
	})
	zoomInTween:Play()
	zoomInTween.Completed:Wait()

	_, humanoid = GetCharacterAndHumanoid()
	if not humanoid then
		isCasting = false
		track:Stop()
		track:Destroy()
		return
	end

	local zoomOutTween = TweenService:Create(localPlayer, zoomOutInfo, {
		CameraMinZoomDistance = ZOOM_MAX_TARGET,
		CameraMaxZoomDistance = ZOOM_MAX_TARGET
	})
	zoomOutTween:Play()
	zoomOutTween.Completed:Wait()

	isCasting = false
	if track then
		track:Stop()
		track:Destroy()
	end
end)
