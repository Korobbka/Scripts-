local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MoneyDataStore = DataStoreService:GetDataStore("MoneyDataStore_v1")
local PurchaseEvent = ReplicatedStorage:WaitForChild("DataStoreMoney")

local SHOP_ITEMS = {
	sword = 100, armor = 200, health = 300, revolver = 400,
	shotgun = 500, rocket = 600, grenade = 700, medkit = 800, ak47 = 900,
}
local purchaseCooldowns = {}

local function formatNumber(value)
	if value < 1000 then return tostring(value) end
	local suffixes = {"K", "M", "Q"}
	local i = 0
	while value >= 1000 and i < #suffixes do
		value /= 1000
		i += 1
	end
	return string.format("%.1f%s", value, suffixes[i])
end

local function savePlayerData(player)
	if player:GetAttribute("DataLoadFailed") then return end
	local rilMoney = player:FindFirstChild("rilMoney")
	if not rilMoney then return end

	pcall(function()
		MoneyDataStore:UpdateAsync(player.UserId, function()
			return rilMoney.Value
		end)
	end)
end

local function giveItem(player, itemName)
	local itemTemplate = ReplicatedStorage:FindFirstChild("Tool")
	if itemTemplate then
		local clone = itemTemplate:Clone()
		clone.Name = itemName
		clone.Parent = player.Backpack
	end
end

PurchaseEvent.OnServerEvent:Connect(function(player, itemName)
	local cost = SHOP_ITEMS[itemName]
	if not cost or purchaseCooldowns[player] then return end

	local rilMoney = player:FindFirstChild("rilMoney")
	if not rilMoney or rilMoney.Value < cost then return end

	purchaseCooldowns[player] = true
	rilMoney.Value -= cost
	giveItem(player, itemName)

	task.wait(0.5)
	if player.Parent then 
		purchaseCooldowns[player] = nil 
	end
end)

Players.PlayerAdded:Connect(function(player)
	local userId = player.UserId
	local savedData = nil
	local success, err
	local attempts = 0

	repeat
		success, err = pcall(function()
			savedData = MoneyDataStore:GetAsync(userId)
		end)
		if not success then
			attempts += 1
			task.wait(1)
		end
	until success or attempts >= 3

	if not success then
		player:SetAttribute("DataLoadFailed", true)
		player:Kick("DataStore Error. Please rejoin.")
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local moneyDisplay = Instance.new("StringValue")
	moneyDisplay.Name = "money"
	moneyDisplay.Parent = leaderstats

	local rilMoney = Instance.new("IntValue")
	rilMoney.Name = "rilMoney"
	rilMoney.Value = savedData or 2000
	rilMoney.Parent = player

	moneyDisplay.Value = formatNumber(rilMoney.Value)

	rilMoney.Changed:Connect(function(newValue)
		moneyDisplay.Value = formatNumber(newValue)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	savePlayerData(player)
	purchaseCooldowns[player] = nil
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		savePlayerData(player)
	end
	task.wait(2)
end)
